# Pulled by `neon env pull`
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Cloudinary. The API key and secret stay on the server.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin panel login
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Owner emails for enquiries and newsletter sign-ups
RESEND_API_KEY=
NOTIFY_EMAIL=gangahandmadeexport@gmail.com
# Optional. Needs a domain verified in Resend.
EMAIL_FROM=

# Customer login
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Mobile OTP provider
SMS_PROVIDER_API_KEY=

# Razorpay test keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
